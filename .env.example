MYSQL_ROOT_PASSWORD=replace_with_a_unique_openssl_rand_hex_32_secret
MYSQL_APP_PASSWORD=replace_with_another_unique_openssl_rand_hex_32_secret

# Optional AI: leave disabled until a server-side key and model are configured.
AI_CHAT_ENABLED=false
# Usage follows the existing Google project billing/quota; local budgets below remain enforced.
AI_CHAT_REQUESTS_PER_DAY=20
AI_CHAT_TOKENS_PER_MINUTE=30000
AI_CHAT_TOKENS_PER_DAY=100000
AI_CHAT_MAX_INPUT_TOKENS=12000
AI_CHAT_PROVIDER=Gemini
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_CHAT_TIMEOUT_SECONDS=20
AI_CHAT_REQUESTS_PER_MINUTE=5
AI_CHAT_MAX_OUTPUT_TOKENS=500
# Server-only Gemini key. Keep the real value in ignored .env, never in source.
GEMINI_API_KEY=
AI_CHAT_HISTORY_TURNS=4

# Existing VM uses ignored private files in ./secrets (parent0700).
MONITORING_SECRETS_DIR=./secrets
GRAFANA_PORT=3000
GRAFANA_PUBLIC_URL=http://localhost:3000/
PROMETHEUS_PORT=9090
