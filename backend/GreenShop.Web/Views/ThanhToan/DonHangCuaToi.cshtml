@model IReadOnlyList<Order>
@using GreenShop.Web.Services
@{ ViewData["Title"] = "Đơn hàng của tôi"; var currentPage = (int)ViewData["Page"]!; var pages = (int)ViewData["TotalPages"]!; }
<section class="shop-page-heading"><span class="shop-eyebrow">GREENSHOP · TÀI KHOẢN</span><h1>Đơn hàng của tôi</h1><p>Theo dõi những đơn hàng đã được lưu của bạn.</p></section>
@if (Model.Count == 0) { <div class="shop-empty"><i class="fa-solid fa-box-open" aria-hidden="true"></i><h2>Bạn chưa có đơn hàng</h2><a class="shop-btn primary" asp-controller="SanPham" asp-action="CuaHang">Khám phá cửa hàng</a></div> }
else { <div class="order-list">@foreach (var order in Model) { <article class="order-list-row shop-panel payment-order-row"><div><a asp-action="ChiTietDonHang" asp-route-id="@order.Id"><h2>Đơn hàng #@order.Id</h2></a><small>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</small><p>@PaymentMethods.Label(order.PaymentMethod)</p><p class="payment-history-hint">Tiền hàng: @(order.Subtotal.HasValue ? OrderWorkflow.Money(order.Subtotal.Value) : "Chưa ghi nhận") · Ship: @(order.ShippingFee.HasValue ? OrderWorkflow.Money(order.ShippingFee.Value) : "Chưa ghi nhận")</p></div><div><span>@OrderWorkflow.Label(order.Status)</span><p class="payment-badge">@PaymentMethods.Status(order)</p></div><strong>@OrderWorkflow.Money(order.Total)</strong><div class="payment-order-links"><a class="shop-text-link" asp-action="ChiTietDonHang" asp-route-id="@order.Id">Xem chi tiết →</a>@if(PaymentMethods.NeedsTransfer(order)) { <a class="shop-btn secondary" asp-action="ThanhToanVietQR" asp-route-id="@order.Id">Xem mã chuyển khoản</a> }</div></article> }</div> }

@if (pages > 1) { <nav class="shop-pagination" aria-label="Phân trang đơn hàng">@if (currentPage > 1) { <a asp-action="DonHangCuaToi" asp-route-page="@(currentPage - 1)">← Trước</a> }<span>Trang @currentPage / @pages</span>@if (currentPage < pages) { <a asp-action="DonHangCuaToi" asp-route-page="@(currentPage + 1)">Tiếp →</a> }</nav> }
