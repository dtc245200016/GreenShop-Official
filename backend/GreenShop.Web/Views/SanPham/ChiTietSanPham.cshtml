@model StoreProductViewModel
@{ ViewData["Title"] = Model.Name; }
<nav class="shop-breadcrumb" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span aria-hidden="true">/</span><a asp-action="CuaHang">Cửa hàng</a><span>/</span>@if (Model.CategoryId.HasValue) { <a asp-action="CuaHang" asp-route-categoryId="@Model.CategoryId">@Model.CategoryName</a><span>/</span> }<span aria-current="page">@Model.Name</span></nav>
<section class="product-detail"><div class="detail-gallery"><div class="detail-media"><img src="@StoreDisplay.Image(Model.ImageUrl)" data-product-image alt="@Model.Name" width="800" height="800" fetchpriority="high" /></div><p class="detail-image-note"><i class="fa-solid fa-leaf" aria-hidden="true"></i> Một chút xanh cho không gian của bạn.</p></div><div class="detail-copy"><span class="shop-eyebrow">@Model.CategoryName</span><h1>@Model.Name</h1><p class="detail-price">@StoreDisplay.Money(Model.Price)</p><div class="detail-facts"><span><i class="fa-regular fa-star" aria-hidden="true"></i>@(Model.ReviewCount>0 ? $"{Model.AverageStars:N1}/5 · {Model.ReviewCount} đánh giá" : "Chưa có đánh giá")</span><span>@(Model.SoldCount > 0 ? $"Đã bán {Model.SoldCount}" : "Chưa có dữ liệu bán")</span></div><p class="detail-stock @(Model.StockQuantity > 0 ? "stock-live" : "stock-empty")"><i class="fa-solid fa-circle" aria-hidden="true"></i>@(Model.StockQuantity > 0 ? $"Còn {Model.StockQuantity} sản phẩm" : "Hết hàng")</p>
@if (!User.IsInRole("Admin")) {
<form asp-controller="GioHang" asp-action="ThemVaoGioHang" asp-route-id="@Model.Id" method="post" class="shopping-controls" data-submit-once>
    <label for="Quantity">Số lượng</label><div class="quantity-control"><button type="button" data-quantity-step="-1" aria-label="Giảm số lượng" disabled="@(Model.StockQuantity <= 0)">−</button><input id="Quantity" name="Quantity" type="number" min="1" max="@Math.Min(1_000_000, Model.StockQuantity)" step="1" value="1" required disabled="@(Model.StockQuantity <= 0)" /><button type="button" data-quantity-step="1" aria-label="Tăng số lượng" disabled="@(Model.StockQuantity <= 0)">+</button></div>
    <div class="detail-actions"><button type="submit" class="shop-btn secondary" disabled="@(Model.StockQuantity <= 0)"><i class="fa-solid fa-cart-plus" aria-hidden="true"></i>Thêm vào giỏ hàng</button><button type="submit" class="shop-btn primary" formaction="@Url.Action("MuaNgay", "ThanhToan", new { id = Model.Id })" disabled="@(Model.StockQuantity <= 0)">Mua ngay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div>
    <small>@(User.Identity?.IsAuthenticated == true ? "Giá và tồn kho sẽ được kiểm tra lại khi xác nhận đặt hàng." : "Đăng nhập để thêm giỏ hàng hoặc mua ngay. Bạn sẽ được quay lại bước mua sắm.")</small>
</form>
} else { <p class="shop-admin-note"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Bạn đang xem bằng tài khoản quản trị. Mua hàng dành cho tài khoản khách hàng.</p> }
<button type="button" class="shop-btn secondary chat-entry" data-chat-mode="shop" aria-controls="hybrid-chat"><i class="fa-regular fa-comments" aria-hidden="true"></i>Chat với Shop</button>
<div class="detail-description"><h2>Về sản phẩm</h2><p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Sản phẩm chưa có mô tả." : Model.Description)</p></div></div></section>

<section class="shop-panel product-reviews" id="reviews"><h2>Đánh giá từ người mua</h2><partial name="_ProductReviews" model="@((IReadOnlyList<ProductReview>?)ViewData["Reviews"] ?? Array.Empty<ProductReview>())" />
@if(Model.ReviewCount>20){var reviewPage=(int?)ViewData["ReviewPage"]??1;<nav class="engagement-pagination" aria-label="Phân trang đánh giá">@if(reviewPage>1){<a class="shop-btn secondary" asp-route-id="@Model.Id" asp-route-reviewPage="@(reviewPage-1)" asp-fragment="reviews">Trang trước</a>}<span>Trang @reviewPage</span>@if(reviewPage*20<Model.ReviewCount){<a class="shop-btn secondary" asp-route-id="@Model.Id" asp-route-reviewPage="@(reviewPage+1)" asp-fragment="reviews">Trang sau</a>}</nav>}
</section>
