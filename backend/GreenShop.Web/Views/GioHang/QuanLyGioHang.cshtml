@model CartViewModel
@{ ViewData["Title"] = "Giỏ hàng của bạn"; }
<section class="shop-page-heading"><span class="shop-eyebrow">GREENSHOP · GIỎ HÀNG</span><h1>Những điều xanh đã chọn</h1><p>Giỏ hàng của riêng bạn. Giá và tồn kho cập nhật từ cửa hàng.</p></section>
@if (Model.Items.Count == 0) { <div class="shop-empty"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i><h2>Giỏ hàng đang trống</h2><p>Khám phá cửa hàng để tìm sản phẩm bạn yêu thích.</p><a class="shop-btn primary" asp-controller="SanPham" asp-action="CuaHang">Khám phá cửa hàng</a></div> }
else
{
<div class="cart-layout"><div class="cart-list">@foreach (var item in Model.Items) { <article class="cart-row" data-cart-id="@item.Id"><img src="@StoreDisplay.Image(item.Product.ImageUrl)" data-product-image alt="@item.Product.Name" width="120" height="120" /><div class="cart-row-copy"><a asp-controller="SanPham" asp-action="ChiTietSanPham" asp-route-id="@item.Product.Id"><h2>@item.Product.Name</h2></a><span class="product-category-label">@item.Product.CategoryName</span><p class="product-price">@StoreDisplay.Money(item.Product.Price)</p><small>@(item.Available ? $"Còn {item.Product.StockQuantity} sản phẩm" : "Sản phẩm đã ngừng bán")</small>@if (!item.CanBuy) { <p class="text-danger small">Số lượng vượt tồn kho hoặc sản phẩm không còn được bán. Vui lòng điều chỉnh hoặc xóa.</p> }<form asp-action="CapNhatSoLuong" asp-route-id="@item.Id" method="post" class="cart-update" data-submit-once><label class="visually-hidden" for="quantity-@item.Id">Số lượng @item.Product.Name</label><input type="number" id="quantity-@item.Id" name="Quantity" min="1" max="@Math.Min(1_000_000, Math.Max(1, item.Product.StockQuantity))" value="@item.Quantity" required /><button class="shop-btn secondary" type="submit" disabled="@(!item.Available || item.Product.StockQuantity <= 0)">Cập nhật</button></form></div><div class="cart-row-actions"><strong>@StoreDisplay.Money(item.Total)</strong><a class="shop-btn primary @(item.CanBuy ? "" : "disabled")" aria-disabled="@(!item.CanBuy ? "true" : null)" href="@(item.CanBuy ? Url.Action("XacNhanMuaHang", "ThanhToan", new { id = item.Product.Id, quantity = item.Quantity }) : null)">Mua sản phẩm này</a><form asp-action="XoaKhoiGioHang" asp-route-id="@item.Id" method="post" data-submit-once><button class="shop-text-link danger" type="submit"><i class="fa-regular fa-trash-can" aria-hidden="true"></i>Xóa khỏi giỏ</button></form></div></article> }</div><aside class="shop-summary"><h2>Tạm tính</h2><strong>@StoreDisplay.Money(Model.Total)</strong><p>Tổng các mục có số lượng hợp lệ. Kiểm tra tiền hàng, phí vận chuyển và chọn COD hoặc VietQR ở bước tiếp theo.</p><p>Thêm vào giỏ chưa giữ chỗ tồn kho.</p><a class="shop-btn primary" aria-disabled="@(Model.Items.All(i=>i.CanBuy) ? null : "true")" href="@(Model.Items.All(i=>i.CanBuy) ? Url.Action("XacNhanGioHang","ThanhToan") : null)">Thanh toán giỏ hàng <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a><a class="shop-btn secondary" asp-controller="SanPham" asp-action="CuaHang">Tiếp tục mua sắm</a></aside></div>
}
