@model IReadOnlyList<AdminOrderRow>
<div class="order-table-wrap" tabindex="0" role="region" aria-label="Bảng đơn hàng, có thể cuộn ngang trên tablet">
    <table class="order-table"><thead><tr><th scope="col">Mã đơn</th><th scope="col">Khách hàng</th><th scope="col">Ngày đặt · UTC</th><th scope="col">Tổng tiền</th><th scope="col">Số lượng</th><th scope="col">Trạng thái</th><th scope="col">Thanh toán</th><th scope="col">Thao tác</th></tr></thead><tbody>
    @foreach (var order in Model)
    {
        <tr data-order-id="@order.Id"><td data-label="Mã đơn"><a class="order-code" asp-action="ChiTietDonHang" asp-route-id="@order.Id">@OrderWorkflow.Code(order.Id)</a></td><td data-label="Khách hàng"><div class="order-customer"><span class="order-avatar" aria-hidden="true">@(string.IsNullOrEmpty(order.CustomerName) ? "?" : order.CustomerName[..1].ToUpperInvariant())</span><div><strong>@order.CustomerName</strong><small>Người nhận: @order.RecipientName</small></div></div></td><td data-label="Ngày đặt"><time datetime="@order.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">@order.CreatedAt.ToString("dd/MM/yyyy")<small>@order.CreatedAt.ToString("HH:mm") UTC</small></time></td><td data-label="Tổng tiền"><strong class="order-amount">@OrderWorkflow.Money(order.Total)</strong></td><td data-label="Số lượng">@order.Quantity</td><td data-label="Trạng thái"><span class="order-badge @OrderWorkflow.Tone(order.Status)">@OrderWorkflow.Label(order.Status)</span></td><td data-label="Thanh toán"><span class="order-payment @(order.IsPaid ? "paid" : "")">@PaymentMethods.Status(order.IsPaid,order.PaymentMethod,order.CustomerTransferNotifiedAt)</span><small>@PaymentMethods.Label(order.PaymentMethod)</small></td><td class="order-row-action" data-label="Thao tác"><a class="order-btn secondary small" asp-action="ChiTietDonHang" asp-route-id="@order.Id" aria-label="Xem đơn @OrderWorkflow.Code(order.Id)">Xem chi tiết <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></td></tr>
    }
    </tbody></table>
</div>
