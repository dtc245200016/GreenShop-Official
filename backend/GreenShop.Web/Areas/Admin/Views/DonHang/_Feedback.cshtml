@if (TempData["SuccessMessage"] is string success) { <div class="order-feedback success" role="status" data-action-feedback><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>@success</span></div> }
@if (!ViewData.ModelState.IsValid) { <div class="order-feedback error" role="alert" data-action-feedback><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><div asp-validation-summary="All"></div></div> }
