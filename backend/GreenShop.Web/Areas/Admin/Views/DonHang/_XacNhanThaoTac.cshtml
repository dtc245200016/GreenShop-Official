<dialog id="orderConfirmDialog" class="order-confirm no-print" aria-labelledby="orderConfirmTitle" aria-describedby="orderConfirmDescription">
    <form id="orderConfirmForm"><header><span class="order-modal-icon"><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i></span><button type="button" class="order-modal-close" data-order-close aria-label="Đóng xác nhận">×</button></header><h2 id="orderConfirmTitle">Xác nhận thao tác</h2><p id="orderConfirmDescription"></p><div id="orderReasonField" hidden><label for="orderReason">Lý do</label><textarea id="orderReason" maxlength="1000" rows="4"></textarea></div><footer><button type="button" class="order-btn secondary" data-order-close autofocus>Hủy bỏ</button><button type="submit" class="order-btn primary" id="orderConfirmSubmit">Lưu thay đổi</button></footer></form>
</dialog>
