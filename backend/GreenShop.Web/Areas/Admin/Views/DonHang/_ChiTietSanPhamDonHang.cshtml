@model AdminOrderDetailViewModel
<section class="order-panel order-items-panel"><div class="order-panel-heading"><h2><i class="fa-solid fa-box-open" aria-hidden="true"></i>Sản phẩm trong đơn</h2><span>@Model.Order.Items.Sum(i => (long)i.Quantity) sản phẩm</span></div>
    <div class="order-purchased-items">@foreach (var item in Model.Order.Items.OrderBy(i => i.Id)) { <article class="order-purchased-item"><img src="@StoreDisplay.Image(item.ImageUrl)" data-order-image alt="@item.ProductName" width="80" height="96" /><div><h3>@item.ProductName</h3><p>Đơn giá lúc mua: @OrderWorkflow.Money(item.UnitPrice)</p><span>Số lượng: <strong>@item.Quantity</strong></span>@if (!item.ProductId.HasValue) { <small class="order-warning-text">Sản phẩm gốc không còn tồn tại. Thông tin mua được giữ nguyên.</small> }</div><strong class="order-amount">@OrderWorkflow.Money(item.UnitPrice * item.Quantity)</strong></article> }</div>
    <div class="order-total"><div><span>Tổng tiền hàng</span><strong>@OrderWorkflow.Money(Model.ItemsTotal)</strong></div><div><span>Phí vận chuyển</span><strong>@(Model.Order.ShippingFee.HasValue ? OrderWorkflow.Money(Model.Order.ShippingFee.Value) : "Chưa ghi nhận trong đơn cũ")</strong></div><div class="order-grand-total"><span>Tổng đơn hàng</span><strong>@OrderWorkflow.Money(Model.Order.Total)</strong></div><p>Đơn giá lấy từ dữ liệu lúc đặt hàng. Không tính lại theo giá hiện tại.</p></div>
</section>
