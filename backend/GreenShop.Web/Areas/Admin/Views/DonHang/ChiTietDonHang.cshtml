@model AdminOrderDetailViewModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"Đơn hàng {OrderWorkflow.Code(order.Id)}";
    var note = ViewData["SubmittedNote"] as string ?? order.AdminNote;
}
<section class="order-admin order-detail @(Model.Print ? "order-print-view" : "")" data-order-id="@order.Id" data-order-version="@order.Version">
    <nav class="order-breadcrumb no-print" aria-label="Breadcrumb"><a asp-area="Admin" asp-controller="Admin" asp-action="Index">Tổng quan</a><span>/</span><a asp-action="QuanLyDonHang">Đơn hàng</a><span>/</span><span aria-current="page">@OrderWorkflow.Code(order.Id)</span></nav>
    <header class="order-page-header"><div><span class="order-eyebrow">GREENSHOP · CHI TIẾT ĐƠN HÀNG</span><h1>@OrderWorkflow.Code(order.Id) <span class="order-badge @OrderWorkflow.Tone(order.Status)">@OrderWorkflow.Label(order.Status)</span></h1><p>Đặt ngày @order.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</p></div><div class="order-header-actions no-print"><a asp-action="QuanLyDonHang" class="order-btn secondary">← Quay lại danh sách</a>@if (Model.Print) { <button type="button" class="order-btn primary" data-order-print><i class="fa-solid fa-print" aria-hidden="true"></i>In đơn hàng</button> } else { <a asp-action="InDonHang" asp-route-id="@order.Id" class="order-btn secondary"><i class="fa-solid fa-print" aria-hidden="true"></i>Xem bản in</a> }</div></header>
    <partial name="_Feedback" />
    @if (!Model.ValidTotal) { <div class="order-feedback error" role="alert">Chi tiết và tổng tiền không khớp. Cần đối chiếu trước khi xử lý đơn; giá lịch sử chưa bị thay đổi.</div> }
    <partial name="_ThaoTacDonHang" model="Model" />
    <section class="order-panel order-progress"><div class="order-panel-heading"><h2>Tiến trình đơn hàng</h2><span>@OrderWorkflow.Label(order.Status)</span></div><ol class="order-steps">@foreach (var step in OrderWorkflow.Steps) { var current = order.Status == step; var index = OrderWorkflow.Steps.ToList().IndexOf(step); var currentIndex = OrderWorkflow.Steps.ToList().IndexOf(order.Status); var done = currentIndex > index; <li class="@(current ? "current" : done ? "done" : "upcoming")" aria-current="@(current ? "step" : null)"><span>@if (done) { <i class="fa-solid fa-check" aria-hidden="true"></i> } else { @(index + 1) }</span><strong>@OrderWorkflow.Label(step)</strong>@if (step == OrderStatus.Pending) { <small>@order.CreatedAt.ToString("dd/MM HH:mm") UTC</small> }</li> }</ol>@if (order.Status == OrderStatus.Cancelled) { <p class="order-cancelled-message"><i class="fa-solid fa-ban" aria-hidden="true"></i>Đơn đã hủy. Các bước giao hàng còn lại không được thực hiện.</p> }<p class="order-progress-caption">Tiến trình phản ánh trạng thái hiện tại; thời điểm chuyển bước chỉ có trong lịch sử được ghi nhận.</p></section>
    <div class="order-detail-grid"><div class="order-detail-main"><partial name="_ChiTietSanPhamDonHang" model="Model" /><partial name="_LichSuTrangThai" model="order" />
        <section class="order-panel order-note-panel no-print"><div class="order-panel-heading"><h2>Ghi chú nội bộ</h2><span>Chỉ dành cho quản trị viên</span></div><form asp-action="CapNhatGhiChuDonHang" asp-route-id="@order.Id" method="post" data-order-submit><input type="hidden" name="ExpectedVersion" value="@order.Version" /><label for="adminNote">Thông tin xử lý đơn hàng</label><textarea id="adminNote" name="Note" maxlength="1000" rows="4" placeholder="Ghi chú giao nhận, thông tin cần lưu ý…">@note</textarea><div class="order-note-footer"><small>Tối đa 1.000 ký tự · Mỗi thay đổi được ghi lịch sử</small><button type="submit" class="order-btn secondary">Lưu ghi chú</button></div></form></section>
    </div><aside class="order-detail-aside">
        <section class="order-panel order-info-panel"><h2>Người mua &amp; giao hàng</h2><dl><dt>Tài khoản</dt><dd>@order.User.FullName</dd><dt>Email</dt><dd>@order.User.Email</dd><dt>Người nhận</dt><dd>@order.RecipientName</dd><dt>Điện thoại giao hàng</dt><dd>@order.Phone</dd><dt>Địa chỉ giao hàng</dt><dd class="order-address">@order.Address</dd></dl></section>
        <section class="order-panel order-info-panel"><h2>Thông tin thanh toán</h2><dl><dt>Phương thức</dt><dd>@PaymentMethods.Label(order.PaymentMethod)</dd><dt>Thanh toán</dt><dd><span class="order-payment @(order.IsPaid ? "paid" : "")">@PaymentMethods.Status(order)</span></dd><dt>Tiền hàng đã lưu</dt><dd>@(order.Subtotal.HasValue ? OrderWorkflow.Money(order.Subtotal.Value) : "Chưa ghi nhận trong đơn cũ")</dd><dt>Phí vận chuyển</dt><dd>@(order.ShippingFee.HasValue ? OrderWorkflow.Money(order.ShippingFee.Value) : "Chưa ghi nhận trong đơn cũ")</dd><dt>Tổng cần thu</dt><dd>@OrderWorkflow.Money(order.Total)</dd>
        @if(order.PaymentMethod==PaymentMethods.VietQr) { <dt>Ngân hàng nhận tiền</dt><dd>@order.BankNameSnapshot</dd><dt>Số tài khoản lúc đặt</dt><dd>@order.BankAccountSnapshot</dd><dt>Tên chủ tài khoản</dt><dd>@order.BankHolderSnapshot</dd><dt>Nội dung chuyển khoản</dt><dd>@order.TransferContent</dd> }
        @if(order.CustomerTransferNotifiedAt.HasValue) { <dt>Khách đã thông báo</dt><dd>@DashboardPeriod.LocalTime(order.CustomerTransferNotifiedAt.Value) · GMT+7</dd> }
        @if(order.PaidAt.HasValue) { <dt>Đã nhận tiền lúc</dt><dd>@DashboardPeriod.LocalTime(order.PaidAt.Value) · GMT+7</dd><dt>Người xác nhận</dt><dd>@order.PaymentConfirmedByName</dd> }
        <dt>Tồn kho</dt><dd>@OrderWorkflow.InventoryLabel(order.InventoryStatus)</dd></dl><p class="order-helper">Thanh toán và giao hàng được ghi nhận riêng. Thông tin tài khoản, giá và phí ship thuộc về thời điểm đặt đơn.</p></section>
    </aside></div>
    <p class="order-print-footnote">GreenShop · @OrderWorkflow.Code(order.Id) · Thông tin đơn hàng từ dữ liệu lúc mua · Ngày giờ UTC</p>
</section>
<partial name="_XacNhanThaoTac" />
@section Scripts { <script src="~/js/admin-orders.js" asp-append-version="true" defer></script> }
