@model IReadOnlyList<AdminNotification>
@{ViewData["Title"]="Thông báo của tôi";var pageNumber=(int)ViewData["Page"]!;}
<section class="engagement-heading"><h1>Thông báo của tôi</h1><p>Trạng thái đọc được lưu riêng cho từng quản trị viên.</p></section>
<section class="engagement-panel">
<form asp-action="DocTatCa" method="post"><button type="submit" class="btn btn-outline-success">Đánh dấu tất cả đã đọc</button></form>
@if(Model.Count==0){<p>Chưa có thông báo.</p>}
@foreach(var notice in Model){<article class="admin-review" data-notification-id="@notice.Id"><strong>@notice.Title</strong><small> · @DashboardPeriod.LocalTime(notice.CreatedAt) · @(notice.ReadAt==null?"Chưa đọc":"Đã đọc")</small><form asp-action="DocThongBao" asp-route-id="@notice.Id" method="post"><button type="submit" class="btn btn-outline-success">Xem nội dung</button></form></article>}
<nav class="engagement-pagination" aria-label="Phân trang thông báo">@if(pageNumber>1){<a asp-route-page="@(pageNumber-1)" class="btn btn-outline-secondary">Trang trước</a>}<span>Trang @pageNumber</span>@if((bool)ViewData["HasNext"]!){<a asp-route-page="@(pageNumber+1)" class="btn btn-outline-secondary">Trang sau</a>}</nav>
</section>
