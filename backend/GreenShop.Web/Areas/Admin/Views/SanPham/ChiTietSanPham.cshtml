@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var currency = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<h2 class="fw-bold mb-4">Chi tiết sản phẩm</h2>
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 400px;" />
            </div>
            <div class="col-md-7">
                <h3>@Model.Name</h3>
                <p class="fs-4 text-success fw-bold">@Model.Price.ToString("N2", currency) VNĐ</p>
                <p><strong>Tồn kho:</strong> @Model.StockQuantity</p>
                <p><strong>Danh mục:</strong> @(Model.Category?.Name ?? "Chưa phân loại")</p>
                <p class="text-muted" style="white-space: pre-wrap;">@(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả." : Model.Description)</p>
                <a asp-action="SuaSanPham" asp-route-id="@Model.Id" class="btn btn-success">Sửa sản phẩm</a>
                <a asp-action="QuanLySanPham" class="btn btn-outline-secondary ms-2">Quay lại</a>
            </div>
        </div>
    </div>
</div>
