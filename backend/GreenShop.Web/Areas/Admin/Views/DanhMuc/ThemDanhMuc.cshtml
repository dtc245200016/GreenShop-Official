@model CategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
}
<partial name="_Assets" />
<section class="category-page category-form-page">
    <a asp-action="QuanLyDanhMuc" class="category-back"><i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>Quản lý danh mục</a>
    <header class="category-page-heading"><span class="category-eyebrow">TỔ CHỨC SẢN PHẨM</span><h1>Thêm danh mục</h1><p>Tạo một nhóm sản phẩm mới cho GreenShop.</p></header>
    <div class="category-panel category-form-panel">
        <form asp-action="ThemDanhMuc" method="post" data-submit-once>
            <partial name="_FormFields" model="Model" />
            <div class="category-form-actions"><button type="submit" class="btn category-primary"><i class="fa-solid fa-check me-2" aria-hidden="true"></i><span data-submit-label>Lưu danh mục</span></button><a asp-action="QuanLyDanhMuc" class="btn category-secondary">Hủy</a></div>
        </form>
    </div>
</section>
