@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success category-feedback" role="status"><i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger category-feedback" role="alert">@error</div>
}
