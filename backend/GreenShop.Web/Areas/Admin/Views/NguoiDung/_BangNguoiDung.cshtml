@model IReadOnlyList<AdminUserRow>
<div class="order-table-wrap"><table class="order-table user-table"><caption class="visually-hidden">Tài khoản GreenShop và quyền truy cập</caption><thead><tr><th>Người dùng</th><th>Liên hệ</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tạo · UTC</th><th>Đơn hàng</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var account in Model) {
    <tr data-user-id="@account.Id"><td data-label="Người dùng"><div class="order-customer"><span class="order-avatar" aria-hidden="true">@account.Initial</span><div><strong>@account.FullName</strong><small>Mã tài khoản #@account.Id</small></div></div></td><td data-label="Liên hệ"><span class="user-email">@account.Email</span><small class="user-phone">@(string.IsNullOrWhiteSpace(account.Phone)?"Chưa có số điện thoại":account.Phone)</small></td><td data-label="Vai trò"><span class="user-role @(account.Role==UserRole.Admin?"administrator":"")">@account.RoleLabel</span></td><td data-label="Trạng thái"><span class="order-badge @(account.IsActive?"delivered":"cancelled")">@(account.IsActive?"Đang hoạt động":"Đã khóa")</span></td><td data-label="Ngày tạo">@account.CreatedAt.ToString("dd/MM/yyyy")<small class="user-phone">@account.CreatedAt.ToString("HH:mm") UTC</small></td><td data-label="Đơn hàng">@account.OrderCount đơn</td><td class="order-row-action"><a class="order-btn secondary" asp-action="ChiTietNguoiDung" asp-route-id="@account.Id">Xem chi tiết <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></td></tr>
}
</tbody></table></div>
